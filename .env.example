MONGODB_URI=your_mongodb_uri_here
JWT_SECRET=your_jwt_secret_here
GOOGLE_CLIENT_ID=your_google_oauth_client_id_here
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret_here
# Public app URL. Use your Vercel production URL or custom domain.
NEXT_PUBLIC_APP_URL=https://your-vercel-app.vercel.app
# Keep empty for the recommended full-stack Vercel deployment.
# Set only if you intentionally call a separate API host.
NEXT_PUBLIC_API_URL=
# Optional. Must exactly match a Google OAuth authorized redirect URI.
GOOGLE_REDIRECT_URI=https://your-vercel-app.vercel.app/api/auth/google/callback
