MONGODB_URI=your_mongodb_uri_here
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRATION=7d

# Public app URL. Use your Render/Vercel production URL or custom domain.
NEXT_PUBLIC_APP_URL=https://your-production-domain.com

# Keep empty for the recommended full-stack deployment.
# Set only if you intentionally call a separate API host.
NEXT_PUBLIC_API_URL=

# Google OAuth. Must exactly match your Google Cloud OAuth client.
GOOGLE_CLIENT_ID=your_google_oauth_client_id_here
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret_here
GOOGLE_REDIRECT_URI=https://your-production-domain.com/api/auth/google/callback
