MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/research_portal
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRATION=7d
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=

# Email verification over HTTPS. Render free services block SMTP ports.
EMAIL_PROVIDER=resend
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxx
EMAIL_FROM=MUJ Research Portal <verified-sender@yourdomain.com>
